# Candidate Kernel image. Legacy images remain the supported complete runtime.
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS kernel-base

ARG KOKONUT_CLICKHOUSE=false

WORKDIR /app

RUN useradd -m -u 10001 -s /bin/bash appuser

# Install one reviewed, hash-checked closure. The optional ClickHouse profile
# has a full superset lock so every selected runtime remains reproducible.
COPY requirements/kernel-runtime.lock requirements/kernel-clickhouse.lock ./requirements/
RUN case "$KOKONUT_CLICKHOUSE" in \
    true) pip install --no-cache-dir --require-hashes -r requirements/kernel-clickhouse.lock ;; \
    false) pip install --no-cache-dir --require-hashes -r requirements/kernel-runtime.lock ;; \
    *) echo "KOKONUT_CLICKHOUSE must be true or false" >&2; exit 1 ;; \
    esac

# Record resolved transitive dependencies inside each artifact. This inventory
# is evidence for comparison, not a lockfile or a claim of reproducibility.
RUN pip list --disable-pip-version-check --format=json > /app/python-packages.json \
    && python3 -VV > /app/python-runtime.txt

COPY services/ ./services/
COPY apps/delphi-participant/ ./apps/delphi-participant/
COPY schemas/ ./schemas/
COPY config/ ./config/
COPY VERSION ./VERSION
COPY pyproject.toml ./pyproject.toml
COPY Dockerfile.kernel ./Dockerfile.kernel
RUN python3 -m services.core.image_manifest --target kernel

RUN mkdir -p /app/private-media /var/lib/kokonut/gateway-audit /var/lib/kokonut/worker-progress \
    && chmod 0700 /app/private-media \
    && chmod 0700 /var/lib/kokonut/gateway-audit \
    && chmod 0700 /var/lib/kokonut/worker-progress \
    && chown -R appuser:appuser /app /var/lib/kokonut \
    && chown appuser:appuser /var/lib/kokonut/worker-progress
USER appuser

EXPOSE 8099

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=20s \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8099/health', timeout=5).close()" || exit 1

CMD ["python3", "-m", "services.core.runtime", "--port", "8099", "--with-workers", "--require-schema"]

# Additive smallest-footprint Kernel profile. Unlike `kernel-base`, this stage
# starts from the same pinned Python base but installs only the core runtime.
# Capability groups remain opt-in build overlays; no runtime secret is a build
# argument or baked into this image.
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS kernel-core-base
ARG KOKONUT_CORE_WEB3=false
ARG KOKONUT_CORE_EXPORTS=false
ARG KOKONUT_CORE_LOCAL_MEDIA=false
WORKDIR /app
RUN useradd -m -u 10001 -s /bin/bash appuser
COPY requirements/kernel-core*.in requirements/kernel-core*.lock requirements/kernel.txt \
     requirements/web3.txt requirements/exports.txt requirements/storage.txt ./requirements/
RUN pip install --no-cache-dir --require-hashes -r requirements/kernel-core.lock \
    && case "$KOKONUT_CORE_WEB3" in \
         true) pip install --no-cache-dir --require-hashes -r requirements/kernel-core-web3.lock ;; \
         false) ;; \
         *) echo "KOKONUT_CORE_WEB3 must be true or false" >&2; exit 1 ;; \
       esac \
    && case "$KOKONUT_CORE_EXPORTS" in \
         true) pip install --no-cache-dir --require-hashes -r requirements/kernel-core-exports.lock ;; \
         false) ;; \
         *) echo "KOKONUT_CORE_EXPORTS must be true or false" >&2; exit 1 ;; \
       esac \
    && case "$KOKONUT_CORE_LOCAL_MEDIA" in \
         true) pip install --no-cache-dir --require-hashes -r requirements/kernel-core-storage.lock ;; \
         false) ;; \
         *) echo "KOKONUT_CORE_LOCAL_MEDIA must be true or false" >&2; exit 1 ;; \
       esac \
    && pip list --disable-pip-version-check --format=json > /app/python-packages.json \
    && python3 -VV > /app/python-runtime.txt
COPY services/ ./services/
COPY apps/delphi-participant/ ./apps/delphi-participant/
COPY schemas/ ./schemas/
COPY config/ ./config/
COPY VERSION ./VERSION
COPY pyproject.toml ./pyproject.toml
COPY Dockerfile.kernel ./Dockerfile.kernel
RUN python3 -m services.core.image_manifest --target kernel-core \
    && mkdir -p /app/private-media /var/lib/kokonut/gateway-audit /var/lib/kokonut/worker-progress \
    && chmod 0700 /app/private-media \
    && chmod 0700 /var/lib/kokonut/gateway-audit \
    && chmod 0700 /var/lib/kokonut/worker-progress \
    && chown -R appuser:appuser /app /var/lib/kokonut \
    && chown appuser:appuser /var/lib/kokonut/worker-progress
USER appuser
EXPOSE 8099
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=20s \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8099/health', timeout=5).close()" || exit 1
CMD ["python3", "-m", "services.core.runtime", "--port", "8099", "--with-workers", "--require-schema"]

FROM kernel-core-base AS kernel-core

# Optional transport target. Generate protobufs inside the image, preserving
# the existing service imports without committing generated Python artifacts.
FROM kernel-base AS grpc
USER root
COPY requirements/grpc.txt ./requirements/grpc.txt
RUN pip install --no-cache-dir -r requirements/grpc.txt \
    && pip list --disable-pip-version-check --format=json > /app/python-packages.json
COPY proto/ ./proto/
RUN mkdir -p /app/generated \
    && python3 -m grpc_tools.protoc -I proto \
       --python_out=/app/generated --grpc_python_out=/app/generated \
       proto/common/pagination.proto proto/ecocredit/v1/types.proto \
       proto/ecocredit/v1/service.proto proto/data/v1/types.proto proto/data/v1/service.proto \
    && cp -r /app/generated/ecocredit services/grpc/ecocredit \
    && cp -r /app/generated/data services/grpc/data \
    && cp -r /app/generated/common services/grpc/common \
    && touch services/grpc/ecocredit/__init__.py services/grpc/ecocredit/v1/__init__.py \
       services/grpc/data/__init__.py services/grpc/data/v1/__init__.py services/grpc/common/__init__.py \
       /app/generated/ecocredit/__init__.py /app/generated/ecocredit/v1/__init__.py \
       /app/generated/data/__init__.py /app/generated/data/v1/__init__.py /app/generated/common/__init__.py \
    && chown -R appuser:appuser /app/generated services/grpc
ENV PYTHONPATH=/app/generated
RUN python3 -m services.core.image_manifest --target grpc \
    && chown appuser:appuser /app/source-manifest.json
USER appuser
EXPOSE 50051
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=20s \
    CMD python3 -m services.grpc.cli health --target 127.0.0.1:50051
CMD ["python3", "-m", "services.grpc.cli", "serve"]

# Optional sensor subscriber. Its broker is a separately selected service.
FROM kernel-base AS mqtt
USER root
COPY requirements/mqtt.txt ./requirements/mqtt.txt
RUN pip install --no-cache-dir -r requirements/mqtt.txt \
    && pip list --disable-pip-version-check --format=json > /app/python-packages.json \
    && chown appuser:appuser /app/python-packages.json
USER appuser
HEALTHCHECK NONE
RUN python3 -m services.core.image_manifest --target mqtt
CMD ["python3", "-m", "services.ingestion.mqtt_subscriber"]

# Optional browser operator identity. The default Kernel target remains free of
# Authlib and itsdangerous; select this target only with the OIDC Compose overlay.
FROM kernel-base AS oidc
USER root
COPY requirements/oidc.txt requirements/http-client.txt ./requirements/
RUN pip install --no-cache-dir \
      -r requirements/oidc.txt -r requirements/http-client.txt \
    && pip list --disable-pip-version-check --format=json > /app/python-packages.json \
    && chown appuser:appuser /app/python-packages.json
COPY apps/operator-console/ ./apps/operator-console/
USER appuser
RUN python3 -m services.core.image_manifest --target oidc
CMD ["python3", "-m", "services.core.runtime", "--port", "8099", "--with-workers", "--require-schema"]

# Resolve and unpack architecture-specific ML wheels on the native build
# platform. This avoids pip network resolution and wheel extraction under QEMU.
FROM --platform=$BUILDPLATFORM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS ml-anomaly-dependencies
ARG TARGETARCH
WORKDIR /build
COPY requirements/ml-anomaly.txt ./requirements/ml-anomaly.txt
COPY requirements/ml-anomaly-runtime.in ./requirements/ml-anomaly-runtime.in
COPY requirements/ml-anomaly-runtime.lock ./requirements/ml-anomaly-runtime.lock
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) set -- --platform=manylinux_2_28_x86_64 --platform=manylinux2014_x86_64 ;; \
      arm64) set -- --platform=manylinux_2_28_aarch64 --platform=manylinux2014_aarch64 ;; \
      *) echo "Unsupported ML worker architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    python3 -m pip install --disable-pip-version-check --no-cache-dir \
      --require-hashes --only-binary=:all: --ignore-installed \
      --target=/opt/ml-anomaly-site \
      "$@" --python-version=3.11 --implementation=cp --abi=cp311 \
      -r requirements/ml-anomaly-runtime.lock

# Optional one-shot ML anomaly worker. The default Kernel target stays small;
# only this explicit profile receives the selected architecture's ML packages.
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93 AS ml-anomaly
WORKDIR /app
RUN useradd -m -u 10001 -s /bin/bash appuser
# The pinned base image includes packaging 26.2. Remove its metadata and code
# before copying the hash-locked runtime (26.3), avoiding ambiguous duplicate
# dist-info selection by pip's package inventory.
RUN rm -rf /usr/local/lib/python3.11/site-packages/packaging \
    /usr/local/lib/python3.11/site-packages/packaging-*.dist-info
COPY --from=ml-anomaly-dependencies /opt/ml-anomaly-site/ /usr/local/lib/python3.11/site-packages/
COPY requirements/ml-anomaly.txt requirements/ml-anomaly-runtime.in requirements/ml-anomaly-runtime.lock ./requirements/
COPY services/ ./services/
COPY schemas/ ./schemas/
COPY config/ ./config/
COPY VERSION ./VERSION
COPY pyproject.toml ./pyproject.toml
COPY Dockerfile.kernel ./Dockerfile.kernel
RUN pip list --disable-pip-version-check --format=json > /app/python-packages.json \
    && python3 -VV > /app/python-runtime.txt \
    && mkdir -p /var/lib/kokonut/ml-models \
    && chown -R appuser:appuser /var/lib/kokonut/ml-models \
    && chown appuser:appuser /app/python-packages.json /app/python-runtime.txt
RUN python3 -m services.core.image_manifest --target ml-anomaly
RUN chown appuser:appuser /app/source-manifest.json
USER appuser
CMD ["python3", "-m", "services.ingestion.sensor_anomaly_ml_cli"]

# Default builds remain the minimal API/worker image.
FROM kernel-base AS kernel
