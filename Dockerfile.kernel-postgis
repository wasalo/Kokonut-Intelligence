# Additive multi-platform database build; not selected by current Compose.
# Package versions must be verified for each target architecture before build.
FROM postgres:16-bookworm@sha256:0ea6700a3b4f0ae6ce746519073558aed4d88a79d8d07622a9a644946c7319c4 AS postgres-base

# Keep the package indexes stable across rebuilds. Debian packages resolve from
# the dated snapshot; the PGDG archive supplies the exact selected PostGIS build.
FROM postgres-base AS apt-snapshot-base
COPY config/postgres/kernel-apt.sources /tmp/kernel-apt.sources
COPY config/postgres/kernel-pgdg.pref /tmp/kernel-pgdg.pref
RUN set -eux; \
    test -s /usr/share/keyrings/debian-archive-keyring.gpg; \
    test -s /usr/local/share/keyrings/postgres.gpg.asc; \
    find /etc/apt/sources.list.d -mindepth 1 -maxdepth 1 -delete; \
    rm -f /etc/apt/sources.list; \
    install -D -m 0644 /tmp/kernel-apt.sources /etc/apt/sources.list.d/kokonut-kernel.sources; \
    install -D -m 0644 /tmp/kernel-pgdg.pref /etc/apt/preferences.d/kokonut-pgdg.pref

# Build-only package discovery. No PostgreSQL process or data volume is started.
FROM apt-snapshot-base AS package-catalog
RUN apt-get update \
    && apt-cache policy postgresql-16-postgis-3 postgresql-16-postgis-3-scripts

FROM apt-snapshot-base AS kernel-postgis

ARG POSTGIS_PACKAGE_VERSION
ARG POSTGIS_SCRIPTS_VERSION
RUN test -n "$POSTGIS_PACKAGE_VERSION" \
    && test -n "$POSTGIS_SCRIPTS_VERSION" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       "postgresql-16-postgis-3=$POSTGIS_PACKAGE_VERSION" \
       "postgresql-16-postgis-3-scripts=$POSTGIS_SCRIPTS_VERSION" \
    && mkdir -p /usr/local/share/kokonut \
    && dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\t${Version}\n' \
       | awk '$1 == "ii" { print $2 "\t" $3 }' \
       > /usr/local/share/kokonut/database-packages.txt \
    && rm -rf /var/lib/apt/lists/*

# Schema extension creation remains owned by the checksummed migration runner.
# No application seeds or automatic extension upgrades are installed here.
