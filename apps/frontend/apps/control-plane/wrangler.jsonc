{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ki-operator-control-plane",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "routes": [
    { "pattern": "hub.kokonut.network/ops", "zone_name": "kokonut.network" },
    { "pattern": "hub.kokonut.network/ops/*", "zone_name": "kokonut.network" },
    { "pattern": "hub.kokonut.network/field", "zone_name": "kokonut.network" },
    { "pattern": "hub.kokonut.network/field/*", "zone_name": "kokonut.network" },
    { "pattern": "hub.kokonut.network/governance", "zone_name": "kokonut.network" },
    { "pattern": "hub.kokonut.network/governance/*", "zone_name": "kokonut.network" },
    { "pattern": "hub.kokonut.network/assets/*", "zone_name": "kokonut.network" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
