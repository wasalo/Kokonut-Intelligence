{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ki-edge-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/healthz", "/api", "/api/*"]
  }
}
