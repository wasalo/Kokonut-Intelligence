{
  "name": "@kokonut/ki-edge-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types",
    "typecheck": "tsc -p tsconfig.json",
    "check:client": "node --check --input-type=commonjs < public/app.js",
    "test": "vitest run",
    "dry-run": "wrangler deploy --dry-run",
    "validate": "npm run types && npm run typecheck && npm run check:client && npm test && npm run dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.2",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "4.143.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
