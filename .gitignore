# Environment (raw secrets — never committed)
.env
.env.local
.env.*.local
# Plaintext staging/production env files must never be committed.
# Encrypted *.sops variants are explicitly allowed below.
deploy/staging/.env.staging
deploy/production/.env.production

# SOPS encrypted files ARE tracked (safe to commit)
!.env.sops

# age private keys (never committed)
*.agekey
keys.txt

# Private keys and secrets
*.pem
*.key
private_key
*_private_key
secrets.json
*.keystore
config/keys/*
!config/keys/README.md

# Data directories (persistent state)
/data/

# Directus
data/uploads/
uploads/

# Node
node_modules/
dist/
*.tsbuildinfo
/sdk/typescript/generated/

# Generated protobuf clients
/sdk/python/generated/*
!/sdk/python/generated/__init__.py

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.env.venv

# ClickHouse
data/clickhouse/

# PostgreSQL
data/postgres/

# Metabase
data/metabase/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml

# Logs
*.log
logs/
.local-cid-store/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/**/dry-run/
contracts/broadcast/**/run-*.json
!contracts/broadcast/**/run-latest.json

# Backups
backups/

# Snapshots (managed separately)
schemas/directus/snapshots/
# Baserow migration code, extracts, and local config are maintained outside Git.
migrations/baserow_to_postgres/
PRD.md
# MQTT TLS material is provisioned outside Git.
config/mosquitto/certs/*
!config/mosquitto/certs/README.md

# Agent-local plans and session artifacts (not repository source)
.hermes/

# Local dev TLS certs for Caddy
config/caddy/certs/
