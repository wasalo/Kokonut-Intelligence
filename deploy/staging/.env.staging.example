# Staging environment — template
#
# Copy to .env.staging, fill in real values, then encrypt:
#   sops -e --input-type dotenv --output-type dotenv \
#     .env.staging > .env.staging.sops
# The plaintext file must never be committed or left on disk.
#
# Conventions:
#   - Placeholders use 'replace-with-strong-<x>-min-24-chars' per repo policy.
#   - Host ports follow docs/deployment-topology.md (staging column).

# ── Environment identity ────────────────────────────────────────────────
KOKONUT_ENV=staging
KOKONUT_ALLOW_PLAINTEXT_ENV=true

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-strong-postgres-min-24-chars
PG_HOST=database
PG_PORT=5432
PG_DB=kokonut_intelligence
PG_USER=kokonut

# ── ClickHouse ──────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=replace-with-strong-clickhouse-min-24-chars
CH_HOST=clickhouse
CH_PORT=8123
CH_USER=kokonut
CH_DB=kokonut_analytics

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-strong-redis-min-24-chars

# ── Directus ────────────────────────────────────────────────────────────
DIRECTUS_SECRET=replace-with-strong-directus-secret-min-24-chars
ADMIN_EMAIL=staging-admin@kokonut.network
ADMIN_PASSWORD=replace-with-strong-admin-min-24-chars
PUBLIC_URL=http://localhost:18056

# ── Metabase ────────────────────────────────────────────────────────────
METABASE_EMBEDDING_SECRET_KEY=replace-with-strong-metabase-min-24-chars

# ── Backups ─────────────────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=replace-with-strong-backup-key-min-24-chars
BACKUP_DIR=/opt/ki-staging/backups

# ── Host port publishes (staging allocation) ────────────────────────────
# Consumed by deploy/staging/docker-compose.staging.yml via !override —
# kept here for documentation; the overlay pins them directly.
# directus 18056, metabase 13001, gateway 18098, grpc 50053

# ── Gnosis / Celo (attestation + DAO indexing) ──────────────────────────
# GNOSIS_RPC_URL=https://rpc.gnosischain.com
# CELO_RPC_URL=https://forno.celo.org
# EAS_SCHEMA_UID=fill-after-registering-staging-schema
