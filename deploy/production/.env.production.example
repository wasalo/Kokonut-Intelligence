# Production environment — template
#
# Copy to .env.production on the production host, fill in real values,
# then encrypt in place with SOPS:
#   cd deploy/production && sops -e -i .env.production
# The encrypted .env.production.sops is committed; plaintext never is.
#
# The production age public key is recorded in deploy/production/.sops.yaml
# (created when the prod host's keypair is generated — see README.md).

# ── Environment identity ────────────────────────────────────────────────
KOKONUT_ENV=production
# Production uses injected secrets / encrypted env — plaintext fallback is OFF.
KOKONUT_ALLOW_PLAINTEXT_ENV=false

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-strong-postgres-min-24-chars
PG_HOST=database
PG_PORT=5432
PG_DB=kokonut_intelligence
PG_USER=kokonut

# ── ClickHouse ──────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=replace-with-strong-clickhouse-min-24-chars
CH_HOST=clickhouse
CH_PORT=8123
CH_USER=kokonut
CH_DB=kokonut_analytics

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-strong-redis-min-24-chars

# ── Directus ────────────────────────────────────────────────────────────
DIRECTUS_SECRET=replace-with-strong-directus-secret-min-24-chars
ADMIN_EMAIL=prod-admin@kokonut.network
ADMIN_PASSWORD=replace-with-strong-admin-min-24-chars
# Public URL = the real production domain served via Traefik
PUBLIC_URL=https://kokonut.network

# ── Public access & CORS ────────────────────────────────────────────────
# AGENTS.md: PUBLIC_RESTRICT=true disables unauthenticated data access.
PUBLIC_RESTRICT=true
# Explicit browser origins only; do not use a wildcard. Same-origin apps need no entry.
CORS_ORIGIN=https://kokonut.network

# ── Optional private Field Collector media storage (S3-compatible) ───────
# Configure only after provisioning an approved private bucket and credentials.
MOBILE_MEDIA_S3_ENDPOINT=
MOBILE_MEDIA_S3_BUCKET=
MOBILE_MEDIA_S3_ACCESS_KEY_ID=
MOBILE_MEDIA_S3_SECRET_ACCESS_KEY=
MOBILE_MEDIA_S3_REGION=auto

# ── Metabase ────────────────────────────────────────────────────────────
METABASE_EMBEDDING_SECRET_KEY=replace-with-strong-metabase-min-24-chars

# ── Backups ─────────────────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=replace-with-strong-backup-key-min-24-chars
BACKUP_DIR=/opt/ki-prod/backups

# ── Traefik routing (docker-compose.traefik.yml) ────────────────────────
KOKONUT_DOMAIN=kokonut.network
KOKONUT_METABASE_DOMAIN=metabase.kokonut.network
KOKONUT_TRAEFIK_NETWORK=coolify-proxy
KOKONUT_TLS_RESOLVER=coolify

# ── Gnosis / Celo (attestation + DAO indexing) ──────────────────────────
GNOSIS_RPC_URL=https://rpc.gnosischain.com
# CELO_RPC_URL=https://forno.celo.org
# EAS_SCHEMA_UID=fill-after-registering-production-schema
