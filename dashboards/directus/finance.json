{
  "name": "Finance",
  "description": "Financial operations: expense approval, revenue tracking, NOI analysis, cost allocation, and budget vs actual for finance team.",
  "icon": "account_balance_wallet",
  "color": "#00695c",
  "modules": [
    {
      "name": "Financial Overview",
      "type": "stats",
      "collection": "noi_snapshot",
      "filters": {
        "location_id": { "_in": "$CURRENT_USER.assigned_locations" }
      },
      "aggregations": [
        { "field": "net_revenue", "function": "sum", "label": "Total Revenue" },
        { "field": "total_costs", "function": "sum", "label": "Total Costs" },
        { "field": "noi", "function": "sum", "label": "Net NOI" },
        { "field": "operating_margin_pct", "function": "avg", "label": "Avg Margin %" }
      ]
    },
    {
      "name": "Pending Expense Approval",
      "type": "table",
      "collection": "expense_event",
      "filters": {
        "location_id": { "_in": "$CURRENT_USER.assigned_locations" },
        "status": { "_eq": "submitted" }
      },
      "columns": [
        { "field": "expense_date", "label": "Date" },
        { "field": "category", "label": "Category" },
        { "field": "amount", "label": "Amount" },
        { "field": "vendor", "label": "Vendor" },
        { "field": "created_by", "label": "Submitted By" },
        { "field": "status", "label": "Status" }
      ],
      "sort": ["-expense_date"]
    },
    {
      "name": "Revenue by Crop",
      "type": "bar",
      "collection": "sales_event",
      "x_axis": { "field": "crop_cycle_id.name" },
      "y_axis": { "field": "total_amount", "function": "sum" },
      "filters": {
        "location_id": { "_in": "$CURRENT_USER.assigned_locations" },
        "sale_date": { "_gte": "$NOW(-90 days)" },
        "status": { "_in": ["verified", "published"] }
      }
    },
    {
      "name": "NOI Trend",
      "type": "line",
      "collection": "noi_snapshot",
      "x_axis": { "field": "period_end", "granularity": "month" },
      "y_axis": [
        { "field": "net_revenue", "label": "Revenue", "color": "#388e3c" },
        { "field": "total_costs", "label": "Costs", "color": "#d32f2f" },
        { "field": "noi", "label": "NOI", "color": "#1976d2" }
      ],
      "filters": {
        "location_id": { "_in": "$CURRENT_USER.assigned_locations" }
      }
    },
    {
      "name": "CapEx Breakdown",
      "type": "table",
      "collection": "capex_breakdown",
      "filters": {
        "location_id": { "_in": "$CURRENT_USER.assigned_locations" }
      },
      "columns": [
        { "field": "category", "label": "Category" },
        { "field": "amount", "label": "Amount" },
        { "field": "depreciation_method", "label": "Depreciation" },
        { "field": "useful_life_years", "label": "Life (yrs)" }
      ],
      "sort": ["-amount"]
    },
    {
      "name": "Verified Expenses",
      "type": "table",
      "collection": "expense_event",
      "filters": {
        "location_id": { "_in": "$CURRENT_USER.assigned_locations" },
        "status": { "_in": ["verified", "published"] },
        "expense_date": { "_gte": "$NOW(-30 days)" }
      },
      "columns": [
        { "field": "expense_date", "label": "Date" },
        { "field": "category", "label": "Category" },
        { "field": "amount", "label": "Amount" },
        { "field": "vendor", "label": "Vendor" },
        { "field": "status", "label": "Status" }
      ],
      "sort": ["-expense_date"]
    }
  ],
  "data_access": {
    "noi_snapshot": {
      "read": "location_id IN ($CURRENT_USER.assigned_locations)",
      "fields": ["net_revenue", "total_costs", "noi", "operating_margin_pct", "period_end"]
    },
    "expense_event": {
      "read": "location_id IN ($CURRENT_USER.assigned_locations)",
      "update": true,
      "fields": ["expense_date", "category", "amount", "vendor", "status", "created_by"]
    },
    "sales_event": {
      "read": "location_id IN ($CURRENT_USER.assigned_locations)",
      "fields": ["sale_date", "quantity", "total_amount", "crop_cycle_id", "status"]
    },
    "capex_breakdown": {
      "read": "location_id IN ($CURRENT_USER.assigned_locations)",
      "fields": ["category", "amount", "depreciation_method", "useful_life_years"]
    }
  }
}
