{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyLimit(20)",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 5am on monday"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": ["pip_requirements", "npm", "github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "matchManagers": ["dockerfile", "github-actions"],
      "pinDigests": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"],
    "automerge": false
  }
}
