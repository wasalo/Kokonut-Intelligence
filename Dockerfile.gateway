# Kokonut Intelligence — API Gateway
# Serves FastAPI gateway routes including the Field Collector companion app.
#
# Build: docker build -f Dockerfile.gateway -t kokonut-gateway .
# Run:   docker compose up -d gateway

FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 10001 -s /bin/bash appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY services/ ./services/
COPY schemas/ ./schemas/
COPY config/ ./config/
COPY pyproject.toml ./pyproject.toml

RUN chown -R appuser:appuser /app

EXPOSE 8099

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=20s \
    CMD curl -fsS http://127.0.0.1:8099/health || exit 1

USER appuser

CMD ["python3", "-m", "services.gateway.cli", "--serve", "--port", "8099"]
