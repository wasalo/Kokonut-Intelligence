# === Runtime ===
# development (default) allows local dev password fallbacks; production requires all secrets
KOKONUT_ENV=development
# Local-only fallback when SOPS is unavailable; never enable in production.
KOKONUT_ALLOW_PLAINTEXT_ENV=false

# === Core Infrastructure ===
POSTGRES_PASSWORD=replace-with-strong-password-min-24-chars
REDIS_PASSWORD=replace-with-strong-password-min-24-chars
DIRECTUS_SECRET=replace-with-random-secret-min-32-chars
ADMIN_EMAIL=admin@kokonut.network
ADMIN_PASSWORD=replace-with-strong-admin-password-min-24-chars
PUBLIC_URL=http://localhost:8055

# === PostgreSQL Direct Connection ===
# Used by Python services for direct psycopg2 connections
PG_HOST=database
PG_PORT=5432
PG_DB=kokonut_intelligence
PG_USER=kokonut
PG_PASSWORD=replace-with-strong-password-min-24-chars

# === ClickHouse Direct Connection ===
CH_HOST=clickhouse
CH_PORT=8123
CH_USER=kokonut
CH_DB=kokonut_analytics

# === Logging ===
KOKONUT_LOG_LEVEL=INFO

# === CIDS Export ===
KOKONUT_CIDS_BASE_URL=https://hub.kokonut.network

# === Directus API ===
DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_TOKEN=replace-with-directus-admin-token

# === Ingestion Retry ===
INGESTION_MAX_RETRIES=3
INGESTION_BACKOFF=2
INGESTION_JITTER=0.5

# === ClickHouse ===
CLICKHOUSE_PASSWORD=replace-with-strong-password-min-24-chars

# === Security (Phase 1) ===
# CORS allowed origins — explicit comma-separated browser origins; never use *.
# Same-origin Field Collector deployments do not need a CORS origin entry.
CORS_ORIGIN=http://localhost:8055,http://localhost:3001

# === Optional private Field Collector media storage (S3-compatible) ===
# Keep the bucket private. Leave endpoint/bucket/credentials blank to disable uploads.
# For Cloudflare R2, use the account S3 API endpoint and region "auto".
MOBILE_MEDIA_S3_ENDPOINT=
MOBILE_MEDIA_S3_BUCKET=
MOBILE_MEDIA_S3_ACCESS_KEY_ID=
MOBILE_MEDIA_S3_SECRET_ACCESS_KEY=
MOBILE_MEDIA_S3_REGION=auto

# === Caddy Reverse Proxy (Phase 2) ===
# Set to your domain for TLS; defaults to localhost with self-signed certs
CADDY_DOMAIN=localhost
# Caddy port bindings — change if 80/443 conflict with existing services
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# === Traefik (alternative to Caddy) ===
# Used with docker-compose.traefik.yml overlay
# KOKONUT_DOMAIN=kokonut.example.com
# KOKONUT_METABASE_DOMAIN=metabase.kokonut.example.com
# KOKONUT_TRAEFIK_NETWORK=traefik
# KOKONUT_TLS_RESOLVER=letsencrypt

# === Infrastructure Alerting ===
# Webhook (Slack/Discord/Teams) — leave blank to disable
ALERT_WEBHOOK_URL=
# Disk/memory alert thresholds (percent)
DISK_THRESHOLD=90
MEM_THRESHOLD=90

# === Weather ===
OpenWeatherMap_API_KEY=your-openweathermap-api-key

# === Sensor Alert Notifications ===
# Email (SMTP) — leave blank to disable email notifications
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@kokonut.network
ALERT_EMAIL_TO=ops@kokonut.network

# === External Data Ingestion ===
# RPC endpoints — free public endpoints (no API key required)
# For production, use dedicated providers (Alchemy, Infura, QuickNode)
ETH_RPC_URL=https://eth.llamarpc.com
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
GNOSIS_RPC_URL=https://rpc.gnosischain.com
CELO_RPC_URL=https://forno.celo.org
CELO_ALFAJORES_RPC_URL=https://alfajores-forno.celo.org

# EAS attestation endpoints
EAS_GRAPHQL_URL=https://attest.sh

# EAS Attestation (Celo primary)
ATTESTER_PRIVATE_KEY=your-attester-private-key
EAS_RESOLVER_ADDRESS=0x...  # filled after KokonutResolver deploy

# === Web3 RPC (Production — get your own keys) ===
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# CELO_RPC_URL=https://celo-mainnet.g.alchemy.com/v2/YOUR_KEY

# === Metabase ===
METABASE_EMBEDDING_SECRET_KEY=replace-with-random-secret-min-32-chars
# MB_DB_TYPE=postgres
