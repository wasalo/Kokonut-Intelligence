# === Runtime ===
# development (default) allows local dev password fallbacks; production requires all secrets
KOKONUT_ENV=development
# Local-only fallback when SOPS is unavailable; never enable in production.
KOKONUT_ALLOW_PLAINTEXT_ENV=false

# === Core Infrastructure ===
POSTGRES_PASSWORD=replace-with-strong-password-min-24-chars
REDIS_PASSWORD=replace-with-strong-password-min-24-chars
DIRECTUS_SECRET=replace-with-random-secret-min-32-chars
ADMIN_EMAIL=admin@kokonut.network
ADMIN_PASSWORD=replace-with-strong-admin-password-min-24-chars
PUBLIC_URL=http://localhost:8055

# === PostgreSQL Direct Connection ===
# Used by Python services for direct psycopg2 connections
PG_HOST=database
PG_PORT=5432
PG_DB=kokonut_intelligence
PG_USER=kokonut
PG_PASSWORD=replace-with-strong-password-min-24-chars

# Optional scheduled sensor CSV input directory. Compose mounts this directory
# read-only at /var/lib/kokonut/sensor-inputs in worker containers. Persisted
# sensor_csv file_path values must resolve beneath that in-container root.
KOKONUT_SENSOR_CSV_HOST_DIR=./data/sensor-inputs

# One-shot Gateway API-key database provisioning only. Do not pass this DSN to
# Gateway containers; keep it in .env.sops and use a separate SELECT/INSERT-only credential.
# Dry-run: source scripts/load-secrets.sh && python3 -m services.gateway.api_key_provisioning
# Insert missing, exact location-scoped hash rows only by adding --apply.
# KOKONUT_API_KEY_PROVISIONER_DSN=postgresql://maintenance-user:...@database:5432/kokonut_intelligence

# Optional dedicated Kernel app credentials. Set both in encrypted secrets and
# combine docker-compose.kernel-runtime-role.yml with a Kernel Compose profile.
KOKONUT_RUNTIME_USER=kokonut_runtime
KOKONUT_RUNTIME_PASSWORD=replace-with-distinct-runtime-password-min-24-chars
KOKONUT_OPERATOR_AUTH_USER=kokonut_operator_auth
KOKONUT_OPERATOR_AUTH_PASSWORD=replace-with-distinct-operator-auth-password-min-24-chars
# Optional event-handler-only notification enqueue login. The bootstrap role
# only provisions this login when its password is set; enable the feature only
# after migration 417 and the dedicated DSN are ready. The handler cannot fall
# back to the shared PG login when the feature is enabled.
# KOKONUT_NOTIFICATION_ENQUEUE_USER=kokonut_notification_enqueue_login
# KOKONUT_NOTIFICATION_ENQUEUE_PASSWORD=load-from-encrypted-secrets
# KOKONUT_NOTIFICATION_ENQUEUE_DATABASE_URL=postgresql://kokonut_notification_enqueue_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_FEATURE_ISOLATED_NOTIFICATION_ENQUEUE=false

# Optional dedicated connection for the signed sensor-anomaly worker. The
# factory reads only this worker-specific DSN and verifies its login is
# kokonut_worker_login; it never falls back to PG_USER or POSTGRES_PASSWORD.
# Compose passes these only to the worker role, then the event bus forwards
# them only to the allowlisted sensor-reading handler. Keep both in .env.sops.
# The worker also requires migration 414 and an exact active database grant for
# sensor_reading/process; no identity or location grant is provisioned here.
# KOKONUT_SENSOR_ANOMALY_DATABASE_URL=postgresql://kokonut_worker_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_SENSOR_ANOMALY_WORKER_CREDENTIAL=load-from-encrypted-secrets

# Optional one-shot signed deterministic-summary, summary-inspection,
# organic-readiness, ecological-modeling, holistic-wellbeing, feedback,
# commons-liberation,
# gnh-alignment, Open Source Capitalist,
# shared-synthesis,
# EBF, CIDS, and Delphi worker profiles. Deterministic
# generation and summary inspection receive separate source credentials;
# generation also receives a draft identity. Organic readiness gets a task-only
# source identity; ecological modeling also uses a task-specific source identity;
# holistic wellbeing uses a three-view identity; feedback uses one consent-safe
# view; commons liberation uses four location-filtered views; GNH Alignment
# uses five location-filtered views; Open Source Capitalist has three
# location-or-network and two network-wide views; remaining Kokonut Commons
# synthesis uses the shared source and draft credentials. EBF, CIDS, and Delphi
# each receive task-specific source credentials.
# Source reads use location/network scope from the signed worker grant; worker
# values belong in .env.sops.
# The candidate schema must include migrations 529, 530, 541, 543, 544, 545,
# 546, 547, 580-592. Summary inspection and generation require an exact
# ai_summary/read grant; CIDS requires an exact cids_export/read grant.
# KOKONUT_AGENT_SUMMARY_DRAFT_DATABASE_URL=postgresql://kokonut_agent_summary_draft_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_SUMMARY_DRAFT_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_SUMMARY_DETERMINISTIC_SOURCE_DATABASE_URL=postgresql://kokonut_agent_summary_deterministic_source_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_SUMMARY_DETERMINISTIC_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_SUMMARY_INSPECTION_SOURCE_DATABASE_URL=postgresql://kokonut_agent_summary_inspection_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_SUMMARY_INSPECTION_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_ORGANIC_READINESS_SOURCE_DATABASE_URL=postgresql://kokonut_agent_organic_readiness_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_ORGANIC_READINESS_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_ECOLOGICAL_MODELING_SOURCE_DATABASE_URL=postgresql://kokonut_agent_ecological_modeling_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_ECOLOGICAL_MODELING_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_HOLISTIC_WELLBEING_SOURCE_DATABASE_URL=postgresql://kokonut_agent_holistic_wellbeing_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_HOLISTIC_WELLBEING_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_FEEDBACK_SOURCE_DATABASE_URL=postgresql://kokonut_agent_feedback_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_FEEDBACK_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_COMMONS_LIBERATION_SOURCE_DATABASE_URL=postgresql://kokonut_agent_commons_liberation_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_COMMONS_LIBERATION_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_GNH_ALIGNMENT_SOURCE_DATABASE_URL=postgresql://kokonut_agent_gnh_alignment_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_GNH_ALIGNMENT_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_REGENERATOR_SOURCE_DATABASE_URL=postgresql://kokonut_agent_regenerator_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_REGENERATOR_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_CAPITAL_EFFICIENCY_SOURCE_DATABASE_URL=postgresql://kokonut_agent_capital_efficiency_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_CAPITAL_EFFICIENCY_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_FINANCIAL_RESILIENCE_SOURCE_DATABASE_URL=postgresql://kokonut_agent_financial_resilience_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_FINANCIAL_RESILIENCE_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_BIO_FACTORY_SOURCE_DATABASE_URL=postgresql://kokonut_agent_bio_factory_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_BIO_FACTORY_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_OPEN_SOURCE_CAPITALIST_SOURCE_DATABASE_URL=postgresql://kokonut_agent_open_source_capitalist_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_OPEN_SOURCE_CAPITALIST_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_SUMMARY_SOURCE_DATABASE_URL=postgresql://kokonut_agent_summary_source_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_SUMMARY_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# EBF, CIDS, and Delphi use separate worker identities and read-only roles.
# KOKONUT_AGENT_EBF_SOURCE_DATABASE_URL=postgresql://kokonut_agent_ebf_source_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_EBF_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_CIDS_SOURCE_DATABASE_URL=postgresql://kokonut_agent_cids_source_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_CIDS_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_AGENT_DELPHI_SOURCE_DATABASE_URL=postgresql://kokonut_agent_delphi_source_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_AGENT_DELPHI_SOURCE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# Migrations 543/544 and an exact active ai_summary/read worker grant for each
# location are required for synthesis and deterministic summaries. Migration
# 545 and an exact active ebf_scorecard/read grant are additionally required
# for the EBF evidence-gap reader. Migration 546 and a cids_export/read grant
# are additionally required for the CIDS export agent; migration 547 adds the
# signed AI-summary list/digest views; migration 581 gives inspection a
# separate identity and a digest-only view; migration 582 gives organic
# readiness its own 15-view identity; migration 583 isolates ecological
# modeling to 27 task projections; migration 584 isolates holistic wellbeing
# to three consent-filtered projections; migration 585 isolates feedback to
# its consent-safe summary; migration 586 isolates commons liberation to four
# location-filtered projections; migration 587 isolates GNH Alignment to five
# location-filtered projections. Source logins are not members of
# worker_execution. Read-only direct synthesis/AI-summary/EBF/CIDS CLI operations
# also require these dedicated source credentials and never fall back to
# shared PG_* settings.

# Optional signed worker path for the two registered cache invalidation handlers.
# It is disabled by default to preserve existing profiles. When enabled, Compose
# exposes these credentials only to the worker supervisor and EventBus forwards
# them only to those exact handlers. Keep both values in .env.sops. Migration 415
# and an exact active computation_cache/invalidate grant are required; enabling
# the flag without them fails closed and retries the event.
# KOKONUT_FEATURE_SIGNED_CACHE_INVALIDATION=false
# KOKONUT_CACHE_INVALIDATION_DATABASE_URL=postgresql://kokonut_worker_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_CACHE_INVALIDATION_WORKER_CREDENTIAL=load-from-encrypted-secrets

# Optional signed worker path for native NOI snapshot reconciliation. Its
# database transaction requires an exact noi_snapshot/reconcile grant for the
# selected location and calls only migration 425's bounded function. The
# scheduler receives these two values and forwards them only to the exact
# services.metrics.noi_snapshot_worker module. Keep both in .env.sops and leave
# this feature disabled until the worker credential/grant are provisioned.
# KOKONUT_FEATURE_SIGNED_NOI_SNAPSHOT_WORKER=false
# KOKONUT_NOI_SNAPSHOT_DATABASE_URL=postgresql://kokonut_worker_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_NOI_SNAPSHOT_WORKER_CREDENTIAL=load-from-encrypted-secrets

# Optional signed worker path for native per-location weather forecast tasks.
# Migration 426 provides a signed location lookup and a bounded atomic function
# for forecast rows, ingestion audit, and ClickHouse outbox projection. The
# scheduler forwards these credentials only to the exact worker module. Keep
# values in .env.sops and the feature disabled until the worker grant exists.
# KOKONUT_FEATURE_SIGNED_WEATHER_FORECAST_WORKER=false
# KOKONUT_WEATHER_FORECAST_DATABASE_URL=postgresql://kokonut_worker_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_WEATHER_FORECAST_WORKER_CREDENTIAL=load-from-encrypted-secrets

# Optional signed worker path for native current-weather observations. Keep
# the provider key separate from the shared legacy OpenWeatherMap setting; the
# scheduler routes this exact key only to services.ingestion.weather_worker.
# KOKONUT_FEATURE_SIGNED_WEATHER_WORKER=false
# KOKONUT_WEATHER_DATABASE_URL=postgresql://kokonut_worker_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_WEATHER_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_WEATHER_OPENWEATHERMAP_API_KEY=load-from-encrypted-secrets

# Optional signed scheduled climate path. Migration 429 provides the signed
# climate/ingest location lookup and source-whitelisted summary/audit function.
# The scheduler forwards this dedicated DSN, credential, and GEE service
# account key path only to services.ingestion.climate_worker. The JSON key file
# must be mounted into the worker container at the configured path. Keep the
# feature off until the migration, credentials, exact location grants, and GEE
# account authorization are ready.
# KOKONUT_FEATURE_SIGNED_CLIMATE_WORKER=false
# KOKONUT_CLIMATE_DATABASE_URL=postgresql://kokonut_worker_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_CLIMATE_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_CLIMATE_GEE_SERVICE_ACCOUNT_KEY=/run/secrets/climate-gee-service-account.json

# Optional isolated global World Bank market-data worker. Migration 430 grants
# one bounded batch/audit function to kokonut_market_data_login; the login has
# no direct table access. Enable only after the runtime-role bootstrap has
# provisioned the dedicated database password and this worker-only DSN.
# WORLD_BANK_PINK_SHEET_URL=https://thedocs.worldbank.org/en/1c3f894e-2c54-48b5-a79d-2e6c9c47b3af/CMO-Historical-Data-Monthly.xlsx
# KOKONUT_FEATURE_ISOLATED_MARKET_DATA_WORKER=false
# KOKONUT_MARKET_DATA_USER=kokonut_market_data_login
# KOKONUT_MARKET_DATA_PASSWORD=load-from-encrypted-secrets
# KOKONUT_MARKET_DATA_DATABASE_URL=postgresql://kokonut_market_data_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence

# Optional isolated global EAS indexer. Migration 433 provides chain locks,
# recipient/cursor lookup, bounded attestation plus ClickHouse-outbox writes,
# and completion auditing. Keep the feature disabled until migration 433 and
# the dedicated login password/DSN are provisioned. The manual legacy EAS CLI
# remains available; the optional Prefect adapter keeps using it until enabled.
# KOKONUT_FEATURE_ISOLATED_EAS_INDEXER_WORKER=false
# KOKONUT_EAS_INDEXER_USER=kokonut_eas_indexer_login
# KOKONUT_EAS_INDEXER_PASSWORD=load-from-encrypted-secrets
# KOKONUT_EAS_INDEXER_DATABASE_URL=postgresql://kokonut_eas_indexer_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence

# Optional isolated global RPC wallet-balance snapshot worker. Migration 436
# provides bounded chain, snapshot, outbox, and status functions. Keep disabled
# until the dedicated login is provisioned and its DSN/provider endpoints are
# loaded from encrypted secrets. The legacy manual RPC CLI remains available.
# KOKONUT_FEATURE_ISOLATED_RPC_INDEXER_WORKER=false
# KOKONUT_RPC_INDEXER_USER=kokonut_rpc_indexer_login
# KOKONUT_RPC_INDEXER_PASSWORD=load-from-encrypted-secrets
# KOKONUT_RPC_INDEXER_DATABASE_URL=postgresql://kokonut_rpc_indexer_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_RPC_INDEXER_RPC_ENDPOINTS={"ethereum":"https://provider.example/rpc?token=..."}

# Optional signed scheduled CSV sensor ingestion. Migration 431 provides the
# bounded location-scoped database functions; the login has no direct table
# privileges and can SET ROLE only to kokonut_worker_execution. Provision its
# password through the one-shot runtime-role bootstrap after migration 431, and
# add an exact active sensor_driver/ingest location grant. Keep the feature off
# until the DSN, credential, location grant, and read-only CSV mount are ready.
# KOKONUT_FEATURE_SIGNED_SENSOR_INGESTION_WORKER=false
# KOKONUT_SENSOR_INGESTION_USER=kokonut_sensor_ingestion_login
# KOKONUT_SENSOR_INGESTION_PASSWORD=load-from-encrypted-secrets
# KOKONUT_SENSOR_INGESTION_DATABASE_URL=postgresql://kokonut_sensor_ingestion_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_SENSOR_INGESTION_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_REMOTE_SENSING_USER=kokonut_remote_sensing_login
# KOKONUT_REMOTE_SENSING_PASSWORD=load-from-encrypted-secrets

# Optional signed, per-location remote-sensing provider worker. Migration 432
# exposes only a due-job claim and atomic observation/audit/outbox completion
# functions to kokonut_remote_sensing_login. Its role is NOLOGIN until the
# runtime-role bootstrap receives the dedicated password. Keep all values encrypted, mount
# the GEE service-account file read-only at the configured path, and provision
# the exact remote_sensing/run location grant before enabling the feature.
# The scheduler forwards this identity and these provider credentials only to
# services.ingestion.remote_sensing_worker; legacy manual commands retain their
# existing global provider settings.
# KOKONUT_FEATURE_SIGNED_REMOTE_SENSING_WORKER=false
# KOKONUT_REMOTE_SENSING_DATABASE_URL=postgresql://kokonut_remote_sensing_login:load-from-encrypted-secrets@database:5432/kokonut_intelligence
# KOKONUT_REMOTE_SENSING_WORKER_CREDENTIAL=load-from-encrypted-secrets
# KOKONUT_REMOTE_SENSING_GEE_SERVICE_ACCOUNT_KEY=/run/secrets/remote-sensing-gee-service-account.json
# KOKONUT_REMOTE_SENSING_COPERNICUS_EMAIL=load-from-encrypted-secrets
# KOKONUT_REMOTE_SENSING_COPERNICUS_PASSWORD=load-from-encrypted-secrets
# KOKONUT_REMOTE_SENSING_COPERNICUS_CLIENT_ID=load-from-encrypted-secrets
# KOKONUT_REMOTE_SENSING_COPERNICUS_CLIENT_SECRET=load-from-encrypted-secrets

# Dedicated global ownership/readiness inventory login. Supply this DSN only
# to `python3 -m services.mobile.tenant_preflight`; never pass it to a service
# container. The kokonut_tenant_preflight login must be read-only, have no role
# memberships, own no public relations, and have no public DML or
# object-creation privileges.
# BYPASSRLS must be off until an inventory relation has RLS enabled; when one
# does, it must be on so aggregate counts cannot be silently row-filtered.
# KOKONUT_TENANT_PREFLIGHT_DSN=postgresql://kokonut_tenant_preflight:load-from-encrypted-secrets@database:5432/kokonut_intelligence

# Optional Directus adapter for the Kernel candidate. Run the explicit
# directus-role-bootstrap and owner-backed directus-bootstrap one-shots before
# starting the optional Directus service. Keep these credentials distinct.
KOKONUT_DIRECTUS_RUNTIME_USER=kokonut_directus_runtime
KOKONUT_DIRECTUS_RUNTIME_PASSWORD=replace-with-distinct-directus-runtime-password-min-24-chars
KOKONUT_KERNEL_DIRECTUS_BIND=127.0.0.1
KOKONUT_KERNEL_DIRECTUS_PORT=18055
KOKONUT_DIRECTUS_PUBLIC_URL=http://127.0.0.1:18055
# KOKONUT_DIRECTUS_CORS_ORIGINS=http://127.0.0.1:18055

# Optional browser operator identity. Include docker-compose.kernel-oidc.yml
# only after registering an HTTPS callback with the selected OIDC provider.
# Keep client/state secrets in .env.sops; do not put secret values in plaintext .env.
# KOKONUT_OPERATOR_OIDC_ISSUER=https://identity.example.invalid
# KOKONUT_OPERATOR_OIDC_CLIENT_ID=kokonut-kernel
# KOKONUT_OPERATOR_OIDC_CLIENT_SECRET=load-from-encrypted-secrets
# KOKONUT_OPERATOR_OIDC_REDIRECT_URI=https://localhost:8448/operator/auth/callback
# KOKONUT_OPERATOR_OIDC_STATE_SECRET=generate-random-secret-at-least-32-bytes
# KOKONUT_OPERATOR_SESSION_TTL_SECONDS=1800

# Optional self-hosted ZITADEL identity provider. Use
# `python3 scripts/kernel-profile.py minimal --zitadel` to include its isolated
# PostgreSQL, API, Login V2, and HTTPS proxy routes. Keep secret values in
# .env.sops. Generate the database password with `openssl rand -hex 32` so it
# is URL-safe for the ZITADEL PostgreSQL DSN. Never change the master key after
# the first successful setup; it protects ZITADEL encryption state.
# KOKONUT_ZITADEL_DOMAIN=zitadel.localhost
# KOKONUT_ZITADEL_POSTGRES_ADMIN_PASSWORD=load-from-encrypted-secrets
# KOKONUT_ZITADEL_DATABASE_PASSWORD=64-hex-characters-from-openssl-rand-hex-32
# KOKONUT_ZITADEL_MASTERKEY=exactly-32-random-characters-from-encrypted-secrets
# KOKONUT_ZITADEL_ADMIN_USERNAME=initial-admin-login-name
# KOKONUT_ZITADEL_ADMIN_PASSWORD=load-from-encrypted-secrets
# KOKONUT_ZITADEL_LOGIN_CLIENT_PAT_EXPIRATION=YYYY-MM-DDTHH:MM:SSZ
# KOKONUT_ZITADEL_LOGIN_COOKIE_SECRET=at-least-32-random-characters-from-encrypted-secrets
# KOKONUT_OPERATOR_OIDC_ISSUER=https://zitadel.localhost:8448
# KOKONUT_OPERATOR_OIDC_CLIENT_ID=created-in-zitadel-console
# KOKONUT_OPERATOR_OIDC_CLIENT_SECRET=load-from-encrypted-secrets
# KOKONUT_OPERATOR_OIDC_REDIRECT_URI=https://localhost:8448/operator/auth/callback
# KOKONUT_OPERATOR_OIDC_STATE_SECRET=load-from-encrypted-secrets

# Optional read-only source login for the curated kokonut_reporting views.
# Provision it with docker-compose.kernel-analytics-role.yml's explicit one-shot profile.
# Standard/portability workers use this reader for saved-query refreshes; it can
# also be configured as the optional Metabase source login. Never reuse PG_USER.
KOKONUT_ANALYTICS_USER=kokonut_analytics_ro
KOKONUT_ANALYTICS_PASSWORD=replace-with-distinct-analytics-password-min-24-chars

# Optional Metabase metadata identity for docker-compose.kernel-metabase.yml.
# Its login owns only the separate metadata database; source access uses the
# read-only KOKONUT_ANALYTICS_USER credential above.
KOKONUT_METABASE_DATABASE=kokonut_metabase
KOKONUT_METABASE_USER=kokonut_metabase_app
KOKONUT_METABASE_PASSWORD=replace-with-distinct-metabase-password-min-24-chars
KOKONUT_METABASE_ENCRYPTION_KEY=replace-with-distinct-base64-metabase-key-min-16-chars
KOKONUT_METABASE_PORT=3001
# One-time local Metabase first-run administrator; keep the generated password
# in .env.sops and never reuse the metadata or analytics-source passwords.
KOKONUT_METABASE_ADMIN_EMAIL=admin@kokonut.invalid
KOKONUT_METABASE_ADMIN_PASSWORD=replace-with-distinct-local-admin-password-min-32-chars

# === ClickHouse Direct Connection ===
CH_HOST=clickhouse
CH_PORT=8123
CH_USER=kokonut
CH_DB=kokonut_analytics

# === Logging ===
KOKONUT_LOG_LEVEL=INFO

# === CIDS Export ===
KOKONUT_CIDS_BASE_URL=https://hub.kokonut.network

# === Directus API ===
DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_TOKEN=replace-with-directus-admin-token

# === Ingestion Retry ===
INGESTION_MAX_RETRIES=3
INGESTION_BACKOFF=2
INGESTION_JITTER=0.5

# === ClickHouse ===
CLICKHOUSE_PASSWORD=replace-with-strong-password-min-24-chars

# === Security (Phase 1) ===
# Directus CORS; this does not configure the FastAPI Gateway.
CORS_ORIGIN=http://localhost:8055
# Gateway CORS allowed origins — explicit comma-separated browser origins; never use *.
# Leave empty for same-origin deployments. Wildcard origins are ignored.
KOKONUT_GATEWAY_CORS_ORIGINS=

# === Optional private Field Collector media storage (S3-compatible) ===
# Keep the bucket private. Leave endpoint/bucket/credentials blank to disable uploads.
# For Cloudflare R2, use the account S3 API endpoint and region "auto".
MOBILE_MEDIA_S3_ENDPOINT=
MOBILE_MEDIA_S3_BUCKET=
MOBILE_MEDIA_S3_ACCESS_KEY_ID=
MOBILE_MEDIA_S3_SECRET_ACCESS_KEY=
MOBILE_MEDIA_S3_REGION=auto

# === Caddy Reverse Proxy (Phase 2) ===
# Set to your domain for TLS; defaults to localhost with self-signed certs
CADDY_DOMAIN=localhost
# Caddy port bindings — change if 80/443 conflict with existing services
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Optional Kernel-only proxy; independent of legacy Caddy settings.
# Defaults are local. Review TLS and ingress before selecting a public bind.
KOKONUT_KERNEL_DOMAIN=localhost
KOKONUT_KERNEL_PROXY_BIND=127.0.0.1
KOKONUT_KERNEL_HTTP_PORT=8088
KOKONUT_KERNEL_HTTPS_PORT=8448
# Gateway token bucket: local or postgres (requires migration 373 and acceptance).
KOKONUT_RATE_LIMIT_PROVIDER=local
# Failed gateway audit writes are journaled on the app's private local volume.
# Increase only after sizing disk and reviewing retention/overflow behavior.
KOKONUT_GATEWAY_AUDIT_SPOOL_MAX_EVENTS=10000
# 0 uses the default alert/restriction threshold (80% of the queue cap).
KOKONUT_GATEWAY_AUDIT_SPOOL_ALERT_THRESHOLD=0

# === Traefik (alternative to Caddy) ===
# Used with docker-compose.traefik.yml overlay
# KOKONUT_DOMAIN=kokonut.example.com
# KOKONUT_METABASE_DOMAIN=metabase.kokonut.example.com
# KOKONUT_TRAEFIK_NETWORK=traefik
# KOKONUT_TLS_RESOLVER=letsencrypt

# === Infrastructure Alerting ===
# Webhook (Slack/Discord/Teams) — leave blank to disable
ALERT_WEBHOOK_URL=
# Notification outbox storage alerts cover the queue, attempts, and operator audit tables.
KOKONUT_NOTIFICATION_OUTBOX_WARN_BYTES=268435456
KOKONUT_NOTIFICATION_OUTBOX_CRITICAL_BYTES=536870912
# Disk/memory alert thresholds (percent)
DISK_THRESHOLD=90
MEM_THRESHOLD=90

# === Weather ===
OpenWeatherMap_API_KEY=your-openweathermap-api-key

# === Sensor Alert Notifications ===
# Email (SMTP) — leave blank to disable email notifications
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@kokonut.network
ALERT_EMAIL_TO=ops@kokonut.network

# === External Data Ingestion ===
# RPC endpoints — free public endpoints (no API key required)
# For production, use dedicated providers (Alchemy, Infura, QuickNode)
ETH_RPC_URL=https://eth.llamarpc.com
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
GNOSIS_RPC_URL=https://rpc.gnosischain.com
CELO_RPC_URL=https://forno.celo.org
CELO_ALFAJORES_RPC_URL=https://alfajores-forno.celo.org

# EAS attestation endpoints
EAS_GRAPHQL_URL=https://attest.sh

# EAS Attestation (Celo primary)
ATTESTER_PRIVATE_KEY=your-attester-private-key
EAS_RESOLVER_ADDRESS=0x...  # filled after KokonutResolver deploy

# === Web3 RPC (Production — get your own keys) ===
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# CELO_RPC_URL=https://celo-mainnet.g.alchemy.com/v2/YOUR_KEY

# === Metabase ===
# Metabase is excluded from default Compose; start it explicitly with --profile metabase.
# Public sharing and static embedding stay disabled unless explicitly enabled.
METABASE_ENABLE_PUBLIC_SHARING=false
METABASE_ENABLE_EMBEDDING_STATIC=false
# If static embedding is separately approved, inject its signing key via the approved secret path.
# MB_DB_TYPE=postgres
# Optional provider selection (legacy defaults preserved during Kernel transition).
# Only true/false are accepted. These switches control capability reporting and
# health probes; Compose services and domain call sites are migrated separately.
KOKONUT_FEATURE_DIRECTUS=true
KOKONUT_FEATURE_CLICKHOUSE=true
KOKONUT_FEATURE_GRPC=true
# Per-message gRPC request/response cap; default 4 MiB, supported range 1 KiB–64 MiB.
GRPC_MAX_MESSAGE_BYTES=4194304
# Optional server cert/key paths and health-client CA path inside the container.
# Mount these files read-only with a deployment-specific Compose override.
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
# Plaintext gRPC is rejected unless explicitly enabled for a trusted private
# network. The local legacy Compose stack defaults this on with loopback-only
# host publishing; docker-compose.prod.yml forces it off.
# GRPC_ALLOW_INSECURE=true
KOKONUT_FEATURE_METABASE=true
KOKONUT_FEATURE_MQTT=true
# Stored dashboard_dataset.query_sql execution is a legacy compatibility path.
# Keep disabled until each retained query has an owner and restricted DB role.
KOKONUT_FEATURE_LEGACY_DATASET_SQL=false
# Optional Kernel MQTT overlay: provision paths and credentials through SOPS.
KOKONUT_MQTT_CERTS_DIR=
KOKONUT_MQTT_SUBSCRIBER_CERTS_DIR=
KOKONUT_MQTT_PASSWORD_FILE=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=
# Legacy keeps automatic acknowledgements; the candidate overlay selects qos1.
MQTT_DELIVERY_MODE=legacy
# Shared HTTP/MQTT timestamp identity. UTC requires a timestamp with timezone.
# Reconcile historical local-clock rows before selecting utc for live ingestion.
KOKONUT_SENSOR_TIMESTAMP_MODE=legacy
KOKONUT_FEATURE_PREFECT=false
# The notification outbox sender is a separate worker process. By default it
# follows KOKONUT_FEATURE_EVENT_BUS; set false to run event dispatch only, or
# true to deliver an existing outbox while event dispatch is disabled.
# KOKONUT_FEATURE_NOTIFICATION_DELIVERY=false
# Event pruning stays disabled until an approved schedule exists and event-level
# legal-hold enforcement is implemented. If enabled, pass explicit --days.
KOKONUT_FEATURE_EVENT_RETENTION_CLEANUP=false

# Private field-media provider. S3 remains the existing default.
MOBILE_MEDIA_PROVIDER=s3
# Local selection requires a dedicated app-owned directory (0700) and a
# 32-byte random encryption key encoded as 64 hex characters, stored via SOPS.
MOBILE_MEDIA_LOCAL_DIRECTORY=
MOBILE_MEDIA_LOCAL_KEY=
